---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% if page.profile.random %}
            <div class="profile-photo-container" style="position: relative;">
              {% comment %}
                Sources are held in data-* attributes so the browser fetches only the photo
                that gets picked, not all of them. See the pickPhoto() script below.
              {% endcomment %}
              {% for photo in site.profile_photos %}
                {% assign photo_base = photo.file | split: '.' | first %}
                <figure class="profile-photo-figure" style="display: none; margin: 0;" data-rarity="{{ photo.rarity | default: 'common' }}">
                  <picture>
                    <source
                      type="image/webp"
                      data-srcset="/assets/img/pfp/{{ photo_base }}-480.webp 480w, /assets/img/pfp/{{ photo_base }}-800.webp 800w"
                      sizes="(min-width: 576px) 30vw, 100vw"
                    >
                    <img
                      data-src="/assets/img/pfp/{{ photo.file }}"
                      class="{{ profile_image_class }}"
                      style="aspect-ratio: 1 / 1;"
                      alt="Profile photo"
                    >
                  </picture>
                  {% if photo.caption and photo.caption != '' %}
                    <figcaption style="margin-top: 0.5rem; font-size: 0.85rem; font-style: italic; text-align: center; opacity: 0.7;">
                      {{ photo.caption }}
                    </figcaption>
                  {% endif %}
                </figure>
              {% endfor %}
            </div>

            <script>
              (function () {
                // 60% common, 30% rare, 10% secret
                const tierWeights = { common: 60, rare: 30, secret: 10 };
                const figures = document.querySelectorAll('.profile-photo-figure');
                const container = document.querySelector('.profile-photo-container');
                if (figures.length > 0) {
                  // Group photos by tier
                  const tiers = { common: [], rare: [], secret: [] };
                  figures.forEach((fig, idx) => {
                    const rarity = fig.dataset.rarity || 'common';
                    if (tiers[rarity]) tiers[rarity].push(idx);
                  });

                  // Promote data-src/data-srcset to real attributes the first time a
                  // photo is shown, so unpicked photos are never fetched.
                  function loadPhoto(fig) {
                    const source = fig.querySelector('source[data-srcset]');
                    if (source) {
                      source.srcset = source.dataset.srcset;
                      delete source.dataset.srcset;
                    }
                    const img = fig.querySelector('img[data-src]');
                    if (img) {
                      img.src = img.dataset.src;
                      delete img.dataset.src;
                    }
                  }

                  function pickPhoto() {
                    // Hide all
                    figures.forEach((fig) => (fig.style.display = 'none'));
                    // Pick a tier (weighted), falling back if tier is empty
                    const roll = Math.random() * 100;
                    let selectedTier;
                    if (roll < tierWeights.secret && tiers.secret.length > 0) {
                      selectedTier = 'secret';
                    } else if (roll < tierWeights.secret + tierWeights.rare && tiers.rare.length > 0) {
                      selectedTier = 'rare';
                    } else {
                      selectedTier = 'common';
                    }
                    // Pick random photo within the tier
                    const pool = tiers[selectedTier];
                    const selectedIdx = pool[Math.floor(Math.random() * pool.length)];
                    loadPhoto(figures[selectedIdx]);
                    figures[selectedIdx].style.display = 'block';
                  }

                  // Initial pick
                  pickPhoto();
                  // Click to reroll
                  container.style.cursor = 'pointer';
                  container.addEventListener('click', pickPhoto);
                }
              })();
            </script>
          {% else %}
            <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="Profile photo" class="{{ profile_image_class }}">
          {% endif %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- Currently Reading and Listening - inline with last paragraph -->
    <!--
      Goodreads + Last.fm "now reading / listening" feature borrowed without
      asking from Andy's site: https://github.com/andyjliu/andyjliu.github.io lol
    -->

    {% assign reading_data = site.data.goodreads_reading %}
    {% assign lastfm_data = site.data.lastfm %}
    {% assign has_lastfm = false %}
    {% if lastfm_data and lastfm_data.artist %}
      {% assign has_lastfm = true %}
    {% endif %}
    {% if reading_data and (reading_data.current_book or reading_data.last_read_book) %}
      {% assign reading_lead = ' I am currently reading ' %}
      <script>
        (function () {
          function escapeHtml(s) {
            return String(s)
              .replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;');
          }

          function dedupePreservingOrder(items) {
            if (!items || !items.length) return [];
            const seen = new Set();
            const out = [];
            for (let i = 0; i < items.length; i++) {
              if (seen.has(items[i])) continue;
              seen.add(items[i]);
              out.push(items[i]);
            }
            return out;
          }

          var readingTooltipTemplate =
            '<div class="tooltip reading-tooltip" role="tooltip"><div class="arrow"></div><div class="tooltip-inner"></div></div>';

          function previousTooltipHtml(lines) {
            if (!lines || !lines.length) return null;
            var rows = lines
              .map(escapeHtml)
              .map(function (line) {
                return '<span class="reading-tooltip-line">' + line + '</span>';
              })
              .join('');
            return '<em>Previously:</em>' + rows;
          }

          document.addEventListener('DOMContentLoaded', function () {
            if (typeof jQuery === 'undefined') return;
            var $ = jQuery;

            const contentDiv = document.querySelector('.clearfix');
            if (!contentDiv) return;
            const paragraphs = contentDiv.querySelectorAll('p');
            if (paragraphs.length === 0) return;
            const lastParagraph = paragraphs[paragraphs.length - 1];

            const bookTitle = {% if reading_data.current_book %}{{ reading_data.current_book.title | jsonify }}{% else %}{{ reading_data.last_read_book.title | jsonify }}{% endif %};
            const bookAuthor = {% if reading_data.current_book %}{% if reading_data.current_book.author %}{{ reading_data.current_book.author | jsonify }}{% else %}null{% endif %}{% else %}{% if reading_data.last_read_book.author %}{{ reading_data.last_read_book.author | jsonify }}{% else %}null{% endif %}{% endif %};

            const previousBookTitlesRaw = {{ reading_data.previous_book_titles | jsonify }} || [];
            const hasLastfm = {{ has_lastfm | jsonify }};
            {% if has_lastfm %}
            const previousArtists = {{ lastfm_data.previous_artists | jsonify }} || [];
            const artistName = {{ lastfm_data.artist | jsonify }};
            {% else %}
            const previousArtists = [];
            const artistName = null;
            {% endif %}

            const readingLead = {{ reading_lead | jsonify }};

            const previousBookTitles = dedupePreservingOrder(previousBookTitlesRaw).filter(function (t) {
              return t && t !== bookTitle;
            });
            const bookTip = previousTooltipHtml(previousBookTitles);
            const $bookPhrase = $('<span>');
            if (bookTip) {
              $bookPhrase.attr('tabindex', '0');
              $bookPhrase.addClass('reading-hover');
              $bookPhrase.tooltip({
                html: true,
                title: bookTip,
                template: readingTooltipTemplate,
                container: 'body',
              });
            }
            $bookPhrase.append(document.createTextNode(bookTitle));
            if (bookAuthor) {
              $bookPhrase.append(document.createTextNode(' by ' + bookAuthor));
            }

            let $artist = null;
            if (hasLastfm && artistName) {
              const artistLines = dedupePreservingOrder(previousArtists).filter(function (a) {
                return a !== artistName;
              });
              const artistTip = previousTooltipHtml(artistLines);
              $artist = $('<span tabindex="0">').text(artistName);
              if (artistTip) {
                $artist.addClass('reading-hover');
                $artist.tooltip({
                  html: true,
                  title: artistTip,
                  template: readingTooltipTemplate,
                  container: 'body',
                });
              }
            }

            $(lastParagraph).append(document.createTextNode(readingLead));
            $(lastParagraph).append($bookPhrase);
            if ($artist) {
              $(lastParagraph).append(document.createTextNode(' and listening to '));
              $(lastParagraph).append($artist);
            }
            $(lastParagraph).append(document.createTextNode('.'));
          });
        })();
      </script>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
